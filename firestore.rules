rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // FONCTIONS COMMUNES
    // =====================================================

    function connecte() {
      return request.auth != null;
    }

    function compteExiste() {
      return connecte()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function compte() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function role(roleNom) {
      return compteExiste()
        && compte().data.role == roleNom;
    }

    function etudiant() {
      return role("etudiant");
    }

    function agent() {
      return role("agent");
    }

    function admin() {
      return role("admin");
    }

    function monMatricule() {
      return compte().data.matricule;
    }

    // -------------------------------------------------
    // ID DÉTERMINISTE POUR VÉRIFIER UNE RELATION D'AMITIÉ
    // -------------------------------------------------
    //
    // Un chemin Firestore ($(...)) ne peut contenir qu'UNE
    // seule interpolation par segment : "$(a)_$(b)" n'est
    // pas une syntaxe valide. On pré-calcule donc l'ID
    // complet dans une fonction, puis on l'insère comme
    // un seul $(...) dans exists()/get().
    //
    // -------------------------------------------------

    function idAmitiePour(beneficiaireMatricule, anneeAcademique) {
      return monMatricule() + "_" + beneficiaireMatricule + "_" + anneeAcademique;
    }

    function monProfil() {
      return compte().data.profile;
    }


    // =====================================================
    // USERS
    // =====================================================

    match /users/{uid} {

      allow get:
        if connecte()
        && request.auth.uid == uid;

      allow list:
        if false;

      allow create, update, delete:
        if false;
    }


    // =====================================================
    // ETUDIANTS
    // =====================================================

    match /etudiants/{documentId} {

      allow read:
        if true;

      allow create, update, delete:
        if false;
    }


    // =====================================================
    // AGENTS
    // =====================================================

    match /agents/{documentId} {

      allow read:
        if true;

      allow create, update, delete:
        if false;
    }


    // =====================================================
    // HEBERGEMENTS
    // =====================================================

    match /hebergements/{documentId} {

      allow get, list:
        if etudiant()
        && resource.data.matricule == monMatricule();

      allow create, update, delete:
        if false;

      allow read:
        if agent()
        || admin();

      allow write:
        if admin();
    }


    // =====================================================
    // DEMANDES ETUDIANTS
    // =====================================================

    match /demandes_etudiants/{documentId} {

      allow get, list:
        if etudiant()
        && resource.data.matricule == monMatricule();

      allow create:
        if etudiant()
        && request.resource.data.matricule == monMatricule()
        && request.resource.data.anneeAcademique is string;

      allow read:
        if agent()
        || admin();

      allow update, delete:
        if agent()
        || admin();
    }


    // =====================================================
    // FRIEND REQUESTS
    // =====================================================

    match /friendRequests/{documentId} {

      allow get, list:
        if etudiant()
        && (
          resource.data.to == monMatricule()
          ||
          resource.data.from == monMatricule()
        );

      allow create:
        if etudiant()
        && request.resource.data.from == monMatricule()
        && request.resource.data.to is string
        && request.resource.data.to != monMatricule()
        && request.resource.data.anneeAcademique is string
        && request.resource.data.status == "pending"
        && request.resource.data.seen == false;

      allow update:
        if etudiant()
        && resource.data.to == monMatricule()
        && request.resource.data.to == resource.data.to
        && request.resource.data.from == resource.data.from
        && request.resource.data.anneeAcademique ==
           resource.data.anneeAcademique;

      allow delete:
        if false;
    }


    // =====================================================
    // FRIENDS
    // =====================================================

    match /friends/{documentId} {

      allow get, list:
        if etudiant()
        && resource.data.userCarte == monMatricule();

      allow create:
        if etudiant()
        && request.resource.data.userCarte == monMatricule()
        && request.resource.data.friendCarte is string
        && request.resource.data.friendCarte != monMatricule()
        && request.resource.data.anneeAcademique is string;

      allow update:
        if etudiant()
        && resource.data.userCarte == monMatricule()
        && request.resource.data.userCarte ==
           resource.data.userCarte
        && request.resource.data.friendCarte ==
           resource.data.friendCarte
        && request.resource.data.anneeAcademique ==
           resource.data.anneeAcademique;

      allow delete:
        if etudiant()
        && resource.data.userCarte == monMatricule();
    }


    // =====================================================
    // NOTIFICATIONS
    // =====================================================

    match /notifications/{documentId} {

      allow get, list:
        if etudiant()
        && resource.data.to == monMatricule();

      allow read:
        if agent()
        || admin();

      allow create:
        if agent()
        || admin()
        ||
        (

          // ===============================================
          // ETUDIANT — NOTIFICATION DE PAIEMENT LOYER
          // ===============================================
          //
          // Utilisé par "payer pour un ami" : le payeur crée
          // 2 notifications, une pour lui-même (confirmation)
          // et une pour le bénéficiaire. On restreint
          // strictement au type "loyer" et on vérifie que
          // le destinataire est bien soi-même OU un ami
          // (relation d'amitié active), pour empêcher tout
          // spam de notification vers un tiers arbitraire.
          //
          // ===============================================

          etudiant()
          && request.resource.data.type == "loyer"
          && request.resource.data.from == monMatricule()
          && request.resource.data.seen == false
          && request.resource.data.anneeAcademique is string
          && (

            // NOTIFICATION À MOI-MÊME
            request.resource.data.to == monMatricule()

            ||

            // NOTIFICATION À UN AMI VÉRIFIÉ
            (
              request.resource.data.to is string
              && request.resource.data.to != monMatricule()
              && exists(
                /databases/$(database)/documents/friends/$(idAmitiePour(request.resource.data.to, request.resource.data.anneeAcademique))
              )
              && get(
                /databases/$(database)/documents/friends/$(idAmitiePour(request.resource.data.to, request.resource.data.anneeAcademique))
              ).data.userCarte == monMatricule()
              && get(
                /databases/$(database)/documents/friends/$(idAmitiePour(request.resource.data.to, request.resource.data.anneeAcademique))
              ).data.friendCarte == request.resource.data.to
            )

          )

        );

      allow update:
        if etudiant()
        && resource.data.to == monMatricule()
        && request.resource.data.to == resource.data.to
        && request.resource.data.anneeAcademique ==
           resource.data.anneeAcademique;

      allow delete:
        if false;
    }


    // =====================================================
    // NOTIFICATIONS RESTAURANT
    // =====================================================

    match /restaurantNotifications/{documentId} {

      allow get, list:
        if etudiant()
        && resource.data.to == monMatricule();

      allow create:
        if false;

      allow update:
        if etudiant()
        && resource.data.to == monMatricule()
        && request.resource.data.to == resource.data.to
        && request.resource.data.anneeAcademique ==
           resource.data.anneeAcademique;

      allow delete:
        if false;
    }


    // =====================================================
    // ANNEES ACADEMIQUES
    // =====================================================

    match /anneesAcademiques/{documentId} {

      allow read:
        if true;

      allow write:
        if admin();
    }


    // =====================================================
    // COLLECTIONS DE REFERENCE
    // =====================================================

    match /sites/{documentId} {

      allow read:
        if connecte();

      allow write:
        if admin();
    }

    match /pavillons/{documentId} {

      allow read:
        if connecte();

      allow write:
        if admin();
    }

    match /services/{documentId} {

      allow read:
        if connecte();

      allow write:
        if admin();
    }

    match /departements/{documentId} {

      allow read:
        if connecte();

      allow write:
        if admin();
    }

    match /ateliers/{documentId} {

      allow read:
        if connecte();

      allow write:
        if admin();
    }

    match /typesTravaux/{documentId} {

      allow read:
        if connecte();

      allow write:
        if admin();
    }


    // =====================================================
    // POSTES / PERMISSIONS
    // =====================================================

    match /postes/{documentId} {

      allow read:
        if agent()
        || admin();

      allow write:
        if admin();
    }

    match /permissionsPostes/{documentId} {

      allow read:
        if agent()
        || admin();

      allow write:
        if admin();
    }


    // =====================================================
    // AFFECTATIONS AGENTS
    // =====================================================

    match /affectationsAgents/{documentId} {

      allow read:
        if agent()
        || admin();

      allow write:
        if admin();
    }


    // =====================================================
    // RATTACHEMENTS
    // =====================================================

    match /rattachements/{documentId} {

      allow read:
        if agent()
        || admin();

      allow write:
        if admin();
    }


    // =====================================================
    // SITUATIONS ACADEMIQUES
    // =====================================================

    match /situationsAcademiques/{documentId} {

      allow get, list:
        if etudiant()
        && resource.data.matricule == monMatricule();

      allow read:
        if agent()
        || admin();

      allow write:
        if agent()
        || admin();
    }


    // =====================================================
    // BONS DE TRAVAIL
    // =====================================================

    match /bons/{documentId} {

      allow read:
        if agent()
        || admin();

      allow create:
        if agent()
        || admin();

      allow update:
        if agent()
        || admin();

      allow delete:
        if false;
    }


    // =====================================================
    // NOTIFICATIONS ATELIER
    // =====================================================

    match /notificationsAtelier/{documentId} {

      allow read:
        if agent()
        && resource.data.site ==
           get(
             /databases/$(database)/documents/agents/$(monMatricule())
           ).data.site;

      allow create:
        if agent()
        || admin();

      allow update:
        if agent()
        && resource.data.site ==
           get(
             /databases/$(database)/documents/agents/$(monMatricule())
           ).data.site;

      allow delete:
        if false;
    }


    // =====================================================
// PAIEMENTS LOYERS
// =====================================================

match /paiementsLoyers/{documentId} {

  // ---------------------------------------------------
  // ETUDIANT — LECTURE D'UN PAIEMENT
  // ---------------------------------------------------
  //
  // Un étudiant peut consulter :
  //
  // 1. son propre paiement ;
  // 2. un paiement qu'il a lui-même effectué pour un ami ;
  // 3. un document inexistant.
  //
  // ---------------------------------------------------

allow get:
  if etudiant()
  && (
    
    // ===============================================
    // DOCUMENT INEXISTANT
    // ===============================================

    resource == null

    ||

    // ===============================================
    // MON PROPRE PAIEMENT
    // ===============================================

    (
      resource.data.matricule == monMatricule()
      &&
      resource.data.beneficiaireMatricule == monMatricule()
    )

    ||

    // ===============================================
    // PAIEMENT QUE J'AI EFFECTUÉ POUR UN AMI
    // ===============================================

    (
      resource.data.paiementPourAmi == true
      &&
      resource.data.payeurMatricule == monMatricule()
      &&
      resource.data.friendDocumentId is string
      &&
      exists(
        /databases/$(database)/documents/friends/$(resource.data.friendDocumentId)
      )
      &&
      get(
        /databases/$(database)/documents/friends/$(resource.data.friendDocumentId)
      ).data.userCarte == monMatricule()
      &&
      get(
        /databases/$(database)/documents/friends/$(resource.data.friendDocumentId)
      ).data.friendCarte == resource.data.beneficiaireMatricule
      &&
      get(
        /databases/$(database)/documents/friends/$(resource.data.friendDocumentId)
      ).data.anneeAcademique == resource.data.anneeAcademique
    )

    ||

    // ===============================================
    // CONSULTATION DE LA SITUATION D'UN AMI
    // ===============================================
    //
    // Permet de lire le paiement d'un ami même quand ce
    // paiement n'a pas été fait par moi (ex: l'ami a payé
    // lui-même son propre mois). On vérifie l'existence
    // d'une relation d'amitié active via l'ID déterministe
    // "userCarte_friendCarte_anneeAcademique".
    //
    // ===============================================

    (
      exists(
        /databases/$(database)/documents/friends/$(idAmitiePour(resource.data.beneficiaireMatricule, resource.data.anneeAcademique))
      )
      &&
      get(
        /databases/$(database)/documents/friends/$(idAmitiePour(resource.data.beneficiaireMatricule, resource.data.anneeAcademique))
      ).data.userCarte == monMatricule()
      &&
      get(
        /databases/$(database)/documents/friends/$(idAmitiePour(resource.data.beneficiaireMatricule, resource.data.anneeAcademique))
      ).data.friendCarte == resource.data.beneficiaireMatricule
    )

  );


  // ---------------------------------------------------
  // ETUDIANT — LISTE
  // ---------------------------------------------------
  //
  // IMPORTANT : pour un "list" (query), Firestore exige
  // que chaque condition porte sur un champ réellement
  // filtré (where(...)) dans la requête envoyée par le
  // client, sinon il refuse toute la requête (même si
  // elle ne renverrait aucun résultat).
  //
  // La requête de "chargerSituationBeneficiaire" filtre
  // sur "matricule" (pas "beneficiaireMatricule") :
  //   where("matricule", "==", beneficiaireMatricule)
  //
  // La règle doit donc, elle aussi, raisonner sur
  // "resource.data.matricule" — jamais sur
  // "beneficiaireMatricule" ici, même si les deux champs
  // contiennent la même valeur dans les documents.
  //
  // ---------------------------------------------------

  allow list:
    if etudiant()
    && (

      // MA PROPRE LISTE
      resource.data.matricule == monMatricule()

      ||

      // PAIEMENT QUE J'AI EFFECTUÉ POUR UN AMI
      (
        resource.data.paiementPourAmi == true
        &&
        resource.data.payeurMatricule == monMatricule()
      )

      ||

      // CONSULTATION DE LA SITUATION D'UN AMI
      (
        exists(
          /databases/$(database)/documents/friends/$(idAmitiePour(resource.data.matricule, resource.data.anneeAcademique))
        )
        &&
        get(
          /databases/$(database)/documents/friends/$(idAmitiePour(resource.data.matricule, resource.data.anneeAcademique))
        ).data.userCarte == monMatricule()
        &&
        get(
          /databases/$(database)/documents/friends/$(idAmitiePour(resource.data.matricule, resource.data.anneeAcademique))
        ).data.friendCarte == resource.data.matricule
      )

    );


  // ---------------------------------------------------
  // ETUDIANT — CREATION
  // ---------------------------------------------------

  allow create:
    if etudiant()

    && request.resource.data.payeurMatricule ==
       monMatricule()

    && request.resource.data.matricule is string

    && request.resource.data.beneficiaireMatricule is string

    && request.resource.data.matricule ==
       request.resource.data.beneficiaireMatricule

    && request.resource.data.anneeAcademique is string

    && request.resource.data.mois is string

    && request.resource.data.montant is number

    && request.resource.data.statut == "paye"

    && request.resource.data.type == "loyer"

    && (

      // -----------------------------------------------
      // PAIEMENT PERSONNEL
      // -----------------------------------------------

      (
        request.resource.data.paiementPourAmi == false

        && request.resource.data.matricule ==
           monMatricule()
      )

      ||

      // -----------------------------------------------
      // PAIEMENT POUR UN AMI
      // -----------------------------------------------

      (
        request.resource.data.paiementPourAmi == true

        && request.resource.data.matricule !=
           monMatricule()

        && request.resource.data.friendDocumentId is string

        && exists(
          /databases/$(database)/documents/friends/$(request.resource.data.friendDocumentId)
        )

        && get(
          /databases/$(database)/documents/friends/$(request.resource.data.friendDocumentId)
        ).data.userCarte ==
           monMatricule()

        && get(
          /databases/$(database)/documents/friends/$(request.resource.data.friendDocumentId)
        ).data.friendCarte ==
           request.resource.data.beneficiaireMatricule

        && get(
          /databases/$(database)/documents/friends/$(request.resource.data.friendDocumentId)
        ).data.anneeAcademique ==
           request.resource.data.anneeAcademique
      )
    );


  // ---------------------------------------------------
  // ETUDIANT — MODIFICATION / SUPPRESSION
  // ---------------------------------------------------

  allow update, delete:
    if false;


  // ---------------------------------------------------
  // AGENT / ADMIN — LECTURE
  // ---------------------------------------------------

  allow read:
    if agent()
    || admin();


  // ---------------------------------------------------
  // ADMIN — ECRITURE
  // ---------------------------------------------------

  allow write:
    if admin();
}


    // =====================================================
    // RECOUVREMENTS
    // =====================================================

    match /recouvrements/{documentId} {

      allow read:
        if agent();

      allow create, update, delete:
        if false;
    }


    // =====================================================
    // TOUT LE RESTE : REFUSE
    // =====================================================

    match /{document=**} {

      allow read, write:
        if false;
    }

  }

}